  ],
  "media": [
    {
      "id": "demo-image",
      "filePath": "sample-media.png",
      "position": [700, 100],
      "size": [160, 160],
      "caption": "Native image imported through MCP"
    },
    {
      "id": "demo-file",
      "filePath": "sample-attachment.txt",
      "position": [700, 350],
      "caption": "Native attachment imported through MCP"
    }
  ],
  "frames": [
    {
      "id": "demo-frame",
      "title": "Pen, curve, link and media",
      "bounds": [50, 50, 1200, 550],
      "childIds": ["demo-pen", "demo-curve", "demo-link", "demo-image", "demo-file"],
      "background": { "light": "#eef2ff", "dark": "#1e293b" },
      "presentationIndex": 0
    }
  ]
